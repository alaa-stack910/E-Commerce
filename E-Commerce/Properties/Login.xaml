<Page x:Class="E_Commerce.Properties.Login"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:E_Commerce.Properties"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Login">

    <Grid>       
        <Grid.Background>

            <ImageBrush ImageSource="/Properties/bd6d68f4aeaa8e77bfa2ddba80.jpg"/>
        </Grid.Background>

        <Border Background="White" Margin="156,46,156,125">
            <StackPanel Margin="0,0,0,70">
                <Label Content=" Login Page " FontWeight="Bold" FontSize ="35" Width="222"></Label>
                <Label Content="Username" FontWeight="Bold" FontSize ="15" Width="437"/>
                <TextBox x:Name="txtusename" Width="405"></TextBox>
                <Label Content="Password" FontWeight="Bold" FontSize ="15" Width="437"/>
                <PasswordBox x:Name="txtPassword" Width="405"></PasswordBox>

                <Button FontSize="17" Margin="20" Click="homeclick" Content="login" Width="198" Height="32"/>

            </StackPanel>

        </Border>

    </Grid>
</Page>
