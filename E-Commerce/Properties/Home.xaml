<Page x:Class="E_Commerce.Properties.Home"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:E_Commerce.Properties"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Home" Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>

        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Label Content="ID :" FontSize="20" Margin="38,16,33,5" />
        <TextBox x:Name="txtid" Margin="11,13,23,13" Grid.Column="1"/>
        <Label Content="Name :" FontSize="20" Grid.Row="1" Margin="38,16,33,5" />
        <TextBox x:Name="txtname" Grid.Row="1" Margin="11,13,23,13" Grid.Column="1"/>
        <Label Content="Price :" FontSize="20" Grid.Row="2" Margin="38,16,33,5" />
        <TextBox x:Name="txtPrice" Grid.Row="2" Margin="11,13,23,13" Grid.Column="1"/>
        <Label Content="Category :" FontSize="20" Grid.Column="2" Grid.Row="0" Margin="38,16,117,5" Grid.ColumnSpan="2" />
        <TextBox x:Name="txtCategory" Grid.Row="0" Margin="11,13,23,13" Grid.Column="3"/>
        <Label Content="Quantity :" FontSize="20" Grid.Row="1" Grid.Column="2" Margin="30,16,125,5" Grid.ColumnSpan="2" />
        <TextBox x:Name="txtQuantity" Grid.Row="1" Margin="11,13,23,13" Grid.Column="3"/>
        <Label Content="Description :" FontSize="20" Grid.Row="2" Margin="17,16,117,5" Grid.Column="2" Grid.ColumnSpan="2" />
        <TextBox x:Name="txtDescription" Grid.Row="2" Margin="11,13,23,13" Grid.Column="3"/>
        <Button Content="Add" Click="addclick" Grid.Column="4" Grid.ColumnSpan="2" Margin="67,0,67,38" Grid.Row="3"/>
        <Button Content="Remove" Click="removeclick" Grid.Column="3" Margin="74,0,90,38" Grid.Row="3" Grid.ColumnSpan="2"/>
        <Button Content="Reload" Click="reloadclick" Grid.Column="2" Grid.ColumnSpan="2" Margin="103,0,76,38" Grid.Row="3"></Button>
        <Button Content="Update" Click="updateclick" Grid.Column="1" Margin="128,0,39,38" Grid.Row="3" Grid.ColumnSpan="2"/>
        <Button Content="Search" Click="searchclick" Grid.Column="1" Margin="1,0,23,38" Grid.Row="3"/>
        <TextBox x:Name="txtsearch" Margin="2,0,10,38" Grid.Row="3" />
        <Button Content="View details" Click="viewclick" Grid.Column="4" Grid.ColumnSpan="2" Margin="90,33,89,5"/>
        <Button Content="Filter" Click="browseclick" Grid.Column="4" Grid.ColumnSpan="2" Margin="90,33,89,5" RenderTransformOrigin="0.466,3.011" Grid.Row="1"/>

        <DataGrid Grid.ColumnSpan="6" Margin="2,55,0,0" Grid.RowSpan="3" Grid.Row="3" AutoGenerateColumns="False"
                  x:Name="dgproducts" SelectionChanged="dgproducts_selection">
            <DataGrid.Columns>

                <DataGridTextColumn Header="ID" Binding="{Binding Id}"></DataGridTextColumn>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}"></DataGridTextColumn>
                <DataGridTextColumn Header="Price" Binding="{Binding Price}"></DataGridTextColumn>
                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}"></DataGridTextColumn>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}"></DataGridTextColumn>

                <DataGridTextColumn Header="Description" Binding="{Binding Description}"></DataGridTextColumn>

            </DataGrid.Columns>
        </DataGrid>




    </Grid>
</Page>
