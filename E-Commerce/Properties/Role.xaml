<Page x:Class="E_Commerce.Properties.Role"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:E_Commerce.Properties"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Role" Background="White">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Properties/bd6d68f4aeaa8e77bfa2ddba80.jpg"/>
        </Grid.Background>
        <Border Background="White" Margin="156,46,156,136">

            <StackPanel>

                <Label Content=" Role Page " FontWeight="Bold" FontSize ="35" Height="64" Width="201"></Label>

                <Label Content="  Role : " FontWeight="Bold" FontSize ="20" Width="335" ></Label>
                <RadioButton x:Name="raguest" Height="28" Width="388">Guest</RadioButton>
                <RadioButton x:Name="racustomer" Height="41" Width="387">Customer</RadioButton>

                <Button Click="signclick" Content="Next" Height="33" Width="210"></Button>
                <Label Width="229">
                    <Hyperlink FontSize ="17" Click="loginclick">
                        <Run Text="Already have account ? login"/>
                    </Hyperlink>
                </Label>

            </StackPanel>

        </Border>

    </Grid>
</Page>
